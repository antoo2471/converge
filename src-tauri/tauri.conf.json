{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Converge",
  "version": "26.10.1",
  "identifier": "app.converge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Converge",
        "decorations": false,
        "dragDropEnabled": false,
        "width": 1380,
        "height": 900,
        "minWidth": 780,
        "minHeight": 600,
        "backgroundColor": "#151210"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' blob: http://artifact.localhost https://artifact.localhost artifact:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Every AI. One space.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "bubblewrap",
          "wmctrl",
          "libxkbcommon0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyQTI3MjIxRUNGQzU3NjkKUldScFYvenNJWEtpY29wTmc4ZjFMWWxXb05KRHRaSDBSUUF0aWNyeGFUcmpXT1hPNld4UGx5ZXIK",
      "endpoints": [
        "https://github.com/antoo2471/converge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
